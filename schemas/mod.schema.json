{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pitwall2000:mod-api:1:mod",
  "title": "Pitwall 2000 mod API 1",
  "allOf": [
    {
      "$ref": "#/$defs/ModManifest"
    }
  ],
  "$defs": {
    "ModManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "modApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}\\.[a-z0-9][a-z0-9.-]{1,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 16384
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,5})(\\.(0|[1-9][0-9]{0,5})){2}$"
        },
        "author": {
          "type": "string",
          "maxLength": 16384
        },
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "gameVersions": {
          "type": "string",
          "maxLength": 16384
        },
        "license": {
          "type": "string",
          "maxLength": 16384
        },
        "homepage": {
          "type": "string",
          "maxLength": 16384
        },
        "preview": {
          "type": "string",
          "maxLength": 16384
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tracks",
              "vehicles",
              "seasons",
              "liveries",
              "driversTeams",
              "modpacks"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/ModRequirement"
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/ModRequirement"
          }
        },
        "replacements": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "requiredFeatures": {
          "type": "array",
          "maxItems": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "required": [
        "schemaVersion",
        "modApiVersion",
        "id",
        "name",
        "version",
        "author",
        "description",
        "gameVersions",
        "license",
        "categories",
        "content"
      ]
    },
    "ModRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 16384
        },
        "version": {
          "type": "string",
          "maxLength": 16384
        }
      }
    }
  }
}